<?xml version='1.0' encoding='utf-8'?>
<plugin id="com.outsystems.plugins.inappbrowser" version="1.6.2" xmlns="http://apache.org/cordova/ns/plugins/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>cordova-outsystems-inappbrowser</name>
    <description>InAppBrowser OutSystems Cordova Plugin</description>
    <author>OutSystems Inc</author>
    
    <js-module name="OSInAppBrowser" src="dist/plugin.js">
        <clobbers target="cordova.plugins.OSInAppBrowser" />
    </js-module>
    <platform name="android">

        <hook type="before_plugin_install" src="hooks/outsystems/handle_cleartextTrafficPermitted.js" />
        <hook type="after_plugin_install" src="hooks/update_r_import.js" />
        <hook type="after_prepare" src="hooks/update_r_import.js" />

        <config-file parent="/*" target="res/xml/config.xml">
            <feature name="OSInAppBrowser">
                <param name="android-package" value="com.outsystems.plugins.inappbrowser.osinappbrowser.OSInAppBrowser" />
            </feature>
            <preference name="GradlePluginKotlinEnabled" value="true" />
            <preference name="GradlePluginKotlinCodeStyle" value="official" />
            <preference name="AndroidXEnabled" value="true"/>
        </config-file>
        
        <config-file parent="/*" target="AndroidManifest.xml">
            <!-- Permissions from OSInAppBrowserLib -->
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.RECORD_AUDIO" />
            <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
            <uses-permission android:name="android.permission.CAMERA" />
            <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
            <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
        </config-file>

        <config-file parent="/manifest/application" target="AndroidManifest.xml">
            <!-- OSInAppBrowserLib Activities -->
            <activity
                android:name="com.outsystems.plugins.inappbrowser.osinappbrowserlib.views.OSIABWebViewActivity"
                android:exported="false"
                android:configChanges="orientation|screenSize|uiMode"
                android:label="OSIABWebViewActivity"
                android:theme="@style/AppTheme.WebView"
                android:enableOnBackInvokedCallback="true" />
            <activity
                android:name="com.outsystems.plugins.inappbrowser.osinappbrowserlib.views.OSIABCustomTabsControllerActivity"
                android:exported="false"
                android:theme="@style/Theme.Transparent"
                android:launchMode="singleTask"
                android:excludeFromRecents="true"
                android:windowSoftInputMode="stateAlwaysHidden|adjustPan" />

            <!-- File Provider for file uploads in WebView -->
            <provider
                android:name="com.outsystems.plugins.inappbrowser.osinappbrowserlib.FileProvider"
                android:authorities="${applicationId}.fileprovider"
                android:exported="false"
                android:grantUriPermissions="true">
                <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/file_paths" />
            </provider>
        </config-file>

        <config-file parent="/manifest" target="AndroidManifest.xml">
            <!-- Custom Tabs queries -->
            <queries>
                <intent>
                    <action android:name="android.intent.action.VIEW" />
                    <category android:name="android.intent.category.BROWSABLE" />
                    <data android:scheme="http" />
                </intent>
                <intent>
                    <action android:name="android.intent.action.VIEW" />
                    <category android:name="android.intent.category.BROWSABLE" />
                    <data android:scheme="https" />
                </intent>
                <intent>
                    <action android:name="android.support.customtabs.action.CustomTabsService" />
                </intent>
            </queries>
        </config-file>
        <source-file src="src/android/OSInAppBrowser.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowser" />
        <source-file src="src/android/OSInAppBrowserError.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowser" />
        <source-file src="src/android/OSInAppBrowserSystemBrowserInputArguments.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowser" />
        <source-file src="src/android/OSInAppBrowserWebViewInputArguments.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowser" />
        <source-file src="src/android/OSIABWebViewManager.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowser" />
        <source-file src="src/android/OSIABWebViewExtensions.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowser" />

        <framework src="src/android/build.gradle" custom="true" type="gradleReference" />

        <!-- OSInAppBrowserLib - Root -->
        <source-file src="src/android/lib/FileProvider.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib" />
        <source-file src="src/android/lib/OSIABClosable.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib" />
        <source-file src="src/android/lib/OSIABEngine.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib" />
        <source-file src="src/android/lib/OSIABEvents.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib" />
        <source-file src="src/android/lib/OSIABRouter.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib" />

        <!-- OSInAppBrowserLib - Helpers -->
        <source-file src="src/android/lib/helpers/OSIABCustomTabsSessionHelper.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib/helpers" />
        <source-file src="src/android/lib/helpers/OSIABCustomTabsSessionHelperInterface.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib/helpers" />
        <source-file src="src/android/lib/helpers/OSIABFlowHelper.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib/helpers" />
        <source-file src="src/android/lib/helpers/OSIABFlowHelperInterface.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib/helpers" />
        <source-file src="src/android/lib/helpers/OSIABPdfHelper.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib/helpers" />

        <!-- OSInAppBrowserLib - Models -->
        <source-file src="src/android/lib/models/OSIABAnimation.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib/models" />
        <source-file src="src/android/lib/models/OSIABBottomSheet.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib/models" />
        <source-file src="src/android/lib/models/OSIABCustomTabsOptions.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib/models" />
        <source-file src="src/android/lib/models/OSIABOptions.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib/models" />
        <source-file src="src/android/lib/models/OSIABToolbarPosition.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib/models" />
        <source-file src="src/android/lib/models/OSIABViewStyle.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib/models" />
        <source-file src="src/android/lib/models/OSIABWebViewOptions.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib/models" />

        <!-- OSInAppBrowserLib - RouterAdapters -->
        <source-file src="src/android/lib/routeradapters/OSIABBaseRouterAdapter.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib/routeradapters" />
        <source-file src="src/android/lib/routeradapters/OSIABCustomTabsRouterAdapter.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib/routeradapters" />
        <source-file src="src/android/lib/routeradapters/OSIABExternalBrowserRouterAdapter.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib/routeradapters" />
        <source-file src="src/android/lib/routeradapters/OSIABWebViewRouterAdapter.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib/routeradapters" />

        <!-- OSInAppBrowserLib - Views -->
        <source-file src="src/android/lib/views/OSIABCustomTabsControllerActivity.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib/views" />
        <source-file src="src/android/lib/views/OSIABWebViewActivity.kt" target-dir="app/src/main/kotlin/com/outsystems/plugins/inappbrowser/osinappbrowserlib/views" />

        <!-- Android Resources -->
        <resource-file src="src/android/res/drawable/back_button_black.xml" target="res/drawable/back_button_black.xml" />
        <resource-file src="src/android/res/drawable/back_button_white.xml" target="res/drawable/back_button_white.xml" />
        <resource-file src="src/android/res/drawable/forward_button_black.xml" target="res/drawable/forward_button_black.xml" />
        <resource-file src="src/android/res/drawable/forward_button_white.xml" target="res/drawable/forward_button_white.xml" />
        <resource-file src="src/android/res/drawable/reload_button_black.xml" target="res/drawable/reload_button_black.xml" />
        <resource-file src="src/android/res/drawable/reload_button_white.xml" target="res/drawable/reload_button_white.xml" />
        <resource-file src="src/android/res/layout/activity_web_view.xml" target="res/layout/activity_web_view.xml" />
        <resource-file src="src/android/res/layout/error_layout.xml" target="res/layout/error_layout.xml" />
        <resource-file src="src/android/res/layout/loading_layout.xml" target="res/layout/loading_layout.xml" />
        <resource-file src="src/android/res/layout/navigation_view.xml" target="res/layout/navigation_view.xml" />
        <resource-file src="src/android/res/values/attrs.xml" target="res/values/attrs.xml" />
        <resource-file src="src/android/res/values/ids.xml" target="res/values/ids.xml" />

        <!-- Merge strings instead of replacing -->
        <config-file parent="/resources" target="res/values/strings.xml">
            <string name="title_activity_osiabweb_view">OSIABWebViewActivity</string>
            <string name="start_button">Start Button</string>
            <string name="close_button">Close</string>
            <string name="end_button">End Button</string>
            <string name="error_screen_text">Couldn\'t load the page content.</string>
            <string name="reload_button_text">Reload page</string>
        </config-file>

        <!-- Merge colors instead of replacing -->
        <config-file parent="/resources" target="res/values/colors.xml">
            <color name="navigation_button_dark_theme">#EAEAEA</color>
            <color name="tool_bar_dark_theme">#292929</color>
            <color name="tool_bar_light_theme">#FFFFFF</color>
            <color name="textPrimary">#000000</color>
            <color name="textPrimaryDark">#FFFFFF</color>
            <color name="urlPrimary">#3F3F3F</color>
            <color name="urlPrimaryDark">#EAEAEA</color>
            <color name="errorText">#626262</color>
            <color name="errorTextDark">#E7E7E7</color>
        </config-file>

        <!-- Merge styles instead of replacing -->
        <config-file parent="/resources" target="res/values/styles.xml">
            <style name="InAppToolBar" parent="Widget.AppCompat.Toolbar">
                <item name="android:background">?attr/toolbarColor</item>
                <item name="android:elevation">4dp</item>
                <item name="android:paddingHorizontal">16dp</item>
            </style>
            <style name="NavigationButton" parent="Widget.AppCompat.ImageButton">
                <item name="android:padding">0dp</item>
                <item name="android:background">@null</item>
                <item name="android:clickable">true</item>
                <item name="android:shadowColor">@android:color/transparent</item>
                <item name="android:backgroundTint">@android:color/transparent</item>
                <item name="android:enabled">@android:color/transparent</item>
                <item name="android:alpha">0.2</item>
            </style>
            <style name="NavigationButton.Back">
                <item name="android:id">@id/start_button</item>
                <item name="android:contentDescription">back_button</item>
                <item name="android:src">?attr/backButtonSrc</item>
                <item name="android:paddingStart">0dp</item>
                <item name="android:paddingEnd">8dp</item>
            </style>
            <style name="NavigationButton.Forward">
                <item name="android:id">@id/end_button</item>
                <item name="android:contentDescription">forward_button</item>
                <item name="android:paddingStart">8dp</item>
                <item name="android:paddingEnd">0dp</item>
                <item name="android:src">?attr/forwardButtonSrc</item>
            </style>
            <style name="URLBar" parent="Widget.AppCompat.TextView">
                <item name="android:id">@id/url_text</item>
                <item name="android:ellipsize">end</item>
                <item name="android:maxLines">1</item>
                <item name="android:singleLine">true</item>
                <item name="android:paddingHorizontal">8dp</item>
                <item name="android:paddingVertical">0dp</item>
                <item name="android:textColor">?attr/urlColor</item>
            </style>
            <style name="CloseButton" parent="Widget.AppCompat.TextView">
                <item name="android:textAllCaps">false</item>
                <item name="android:textColor">?attr/colorPrimary</item>
                <item name="android:textStyle">bold</item>
                <item name="android:backgroundTint">@android:color/transparent</item>
                <item name="android:background">@android:color/transparent</item>
                <item name="android:paddingStart">8dp</item>
                <item name="android:paddingEnd">8dp</item>
            </style>
            <style name="Theme.Transparent" parent="Theme.AppCompat.NoActionBar">
                <item name="android:windowBackground">@android:color/transparent</item>
                <item name="android:windowContentOverlay">@null</item>
                <item name="android:windowIsTranslucent">true</item>
                <item name="android:windowNoTitle">true</item>
                <item name="android:windowIsFloating">true</item>
                <item name="android:backgroundDimEnabled">false</item>
            </style>
        </config-file>

        <!-- Merge themes instead of replacing -->
        <config-file parent="/resources" target="res/values/themes.xml">
            <style name="AppTheme.WebView" parent="Theme.AppCompat.DayNight.NoActionBar">
                <item name="windowActionBar">false</item>
                <item name="windowNoTitle">true</item>
                <item name="backButtonSrc">@drawable/back_button_black</item>
                <item name="forwardButtonSrc">@drawable/forward_button_black</item>
                <item name="reloadButtonSrc">@drawable/reload_button_black</item>
                <item name="colorPrimary">@color/textPrimary</item>
                <item name="urlColor">@color/urlPrimary</item>
                <item name="backgroundTint">@null</item>
                <item name="backgroundTintMode">@null</item>
                <item name="toolbarColor">@color/tool_bar_light_theme</item>
                <item name="errorTextColor">@color/errorText</item>
            </style>
        </config-file>
        <resource-file src="src/android/res/values-night/themes.xml" target="res/values-night/themes.xml" />
        <resource-file src="src/android/res/values-v28/styles.xml" target="res/values-v28/styles.xml" />
        <resource-file src="src/android/res/xml/file_paths.xml" target="res/xml/file_paths.xml" />
    </platform>
    <platform name="ios">
        <config-file parent="/*" target="config.xml">
            <feature name="OSInAppBrowser">
                <param name="ios-package" value="OSInAppBrowser" />
            </feature>
            <preference name="SwiftVersion" value="5" />
        </config-file>

        <source-file src="src/ios/OSInAppBrowser.swift" />
        <source-file src="src/ios/OSInAppBrowserError.swift" />
        <source-file src="src/ios/OSInAppBrowserInputArgumentsModel.swift" />
        <source-file src="src/ios/OSIABWebViewModelManager.swift" />
        <source-file src="src/ios/OSIABWebViewModel+ScriptExtensions.swift" />

        <!-- OSInAppBrowserLib - Models -->
        <source-file src="src/ios/lib/Models/OSIABAnimationEffect.swift" />
        <source-file src="src/ios/lib/Models/OSIABDismissStyle.swift" />
        <source-file src="src/ios/lib/Models/OSIABToolbarPosition.swift" />
        <source-file src="src/ios/lib/Models/OSIABViewStyle.swift" />
        <source-file src="src/ios/lib/Models/OSIABWebViewConfigurationModel.swift" />
        <source-file src="src/ios/lib/Models/OSIABWebViewUIModel.swift" />

        <!-- OSInAppBrowserLib - Models/Options -->
        <source-file src="src/ios/lib/Models/Options/OSIABOptions.swift" />
        <source-file src="src/ios/lib/Models/Options/OSIABSystemBrowserOptions.swift" />
        <source-file src="src/ios/lib/Models/Options/OSIABWebViewOptions.swift" />

        <!-- OSInAppBrowserLib - Root -->
        <source-file src="src/ios/lib/OSIABCacheManager.swift" />
        <source-file src="src/ios/lib/OSIABEngine.swift" />
        <source-file src="src/ios/lib/OSIABRouter.swift" />

        <!-- OSInAppBrowserLib - RouterAdapters -->
        <source-file src="src/ios/lib/RouterAdapters/OSIABApplicationRouterAdapter.swift" />
        <source-file src="src/ios/lib/RouterAdapters/OSIABSafariViewControllerRouterAdapter.swift" />
        <source-file src="src/ios/lib/RouterAdapters/OSIABWebViewRouterAdapter.swift" />

        <!-- OSInAppBrowserLib - WebView -->
        <source-file src="src/ios/lib/WebView/OSIABWebViewCallbackHandler.swift" />
        <source-file src="src/ios/lib/WebView/OSIABWebViewModel.swift" />

        <!-- OSInAppBrowserLib - WebView/Views -->
        <source-file src="src/ios/lib/WebView/Views/OSIABErrorView.swift" />
        <source-file src="src/ios/lib/WebView/Views/OSIABNavigationView.swift" />
        <source-file src="src/ios/lib/WebView/Views/OSIABWebView.swift" />
        <source-file src="src/ios/lib/WebView/Views/OSIABWebView13WrapperView.swift" />
        <source-file src="src/ios/lib/WebView/Views/OSIABWebViewRepresentable.swift" />
        <source-file src="src/ios/lib/WebView/Views/OSIABWebViewWrapperView.swift" />

        <!-- OSInAppBrowserLib - WebView/Views/Modifiers -->
        <source-file src="src/ios/lib/WebView/Views/Modifiers/OSIABViewModifiers.swift" />
    </platform>
</plugin>
